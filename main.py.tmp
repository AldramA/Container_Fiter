    def add_items(self):
        """Add items to the container based on GUI input"""
        try:
            # Input validation
            if not all(field.get().strip() for field in [
                self.length_entry, self.width_entry, 
                self.height_entry, self.weight_entry
            ]):
                raise ValueError("All dimensions and weight are required")
            
            # Parse numeric inputs
            try:
                length = float(self.length_entry.get())
                width = float(self.width_entry.get())
                height = float(self.height_entry.get())
                weight = float(self.weight_entry.get())
                quantity = int(self.quantity_entry.get() or "1")
            except ValueError:
                raise ValueError("Please enter valid numbers for dimensions, weight and quantity")
            
            # Validate positive values
            if any(x <= 0 for x in [length, width, height, weight, quantity]):
                raise ValueError("All values must be positive")
            
            # Get item type
            selected_type = self.item_type_var.get()
            item_type = None if selected_type == "Auto" else selected_type
            
            # Get base name
            base_name = self.name_entry.get().strip()
            
            # Determine effective type for naming
            effective_type = item_type if item_type else self._determine_item_type(length, width, height)
            
            # Create items
            items = []
            for i in range(quantity):
                try:
                    # Generate unique name
                    item_name = self._generate_unique_name(base_name, effective_type, quantity, i)
                    
                    # Create item
                    item = Item(
                        length=length,
                        width=width,
                        height=height,
                        weight=weight,
                        name=item_name,
                        item_type=item_type
                    )
                    items.append(item)
                    
                except Exception as e:
                    messagebox.showerror("Error", f"Failed to create item {i+1}: {str(e)}")
                    continue
            
            # Add successful items
            if items:
                self.items.extend(items)
                self.update_items_display()
                self.clear_entry_fields()
                messagebox.showinfo("Success", f"Added {len(items)} items successfully")
            else:
                raise ValueError("No valid items were created")
            
        except ValueError as e:
            messagebox.showerror("Input Error", str(e))
        except Exception as e:
            messagebox.showerror("Error", f"Failed to add items: {str(e)}")
